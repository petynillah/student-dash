{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/student/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/student/:path*", "destination": "/index.html" },
    { "source": "/student", "destination": "/index.html" },
    { "source": "/studentdash", "destination": "/index.html" },
    { "source": "/studentlogin", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ]
}